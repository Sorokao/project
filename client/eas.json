{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://YOUR-BACKEND-URL",
        "EXPO_PUBLIC_BILLING_MODE": "mock"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://YOUR-BACKEND-URL",
        "EXPO_PUBLIC_BILLING_MODE": "play"
      }
    }
  }
}